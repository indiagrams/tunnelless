+/// Lock-guarded storage for a value written once and read from any isolation.
+///
+/// Deliberately not an actor: the point is to be readable synchronously from a
+/// `nonisolated` context while the owning actor is blocked.
+private final class LoopbackStore: @unchecked Sendable {
+    private let lock = NSLock()
+    private var stored: TailscaleNode.LoopbackConfig?
+
+    var value: TailscaleNode.LoopbackConfig? {
+        get { lock.lock(); defer { lock.unlock() }; return stored }
+        set { lock.lock(); defer { lock.unlock() }; stored = newValue }
+    }
+}
