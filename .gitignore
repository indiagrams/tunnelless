# Swift / Xcode
**/build/
**/DerivedData/
**/.build/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/
**/*.xcodeproj/project.xcworkspace/xcuserdata/
**/Package.resolved.bak
*.swiftpm/
xcuserdata/

# XcodeGen-generated Info.plists (regenerated from project.yml)
app/iOS/Generated-Info.plist
app/macOS/Generated-Info.plist

# XcodeGen-generated project (regenerated from project.yml)
# Tuist-generated project + workspace + cache (regenerated from app/Project.swift)
app/Tunnelless.xcodeproj
app/Tunnelless.xcworkspace
app/Derived/
.tuist/

# Editor
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~

# Planning + scratch (local-only)
.planning/

# Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.p8
*.p12
*.mobileprovision
secrets/

# Build / dist
dist/
build/

# Logs
*.log
logs/

# Fastlane runtime artifacts
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output
fastlane/README.md
# Screenshot output — regenerable from `make screenshots`. Don't track binaries.
fastlane/screenshots/**/*.png
fastlane/screenshots/**/*.html
fastlane/Mac_screenshots/**/*.png
.bundle/
vendor/bundle/

# OS
Thumbs.db
ehthumbs.db

# Generated artifacts (regenerable from CHANGELOG.md)
release-notes.md
.bootstrap.env
.claude/

# Built by tailscale/build-tailscalekit.sh (~50MB of Go-compiled slices).
# Deliberately not committed: the pipeline that produces it IS the reference.
vendor/TailscaleKit.xcframework/
# Shipped alongside the xcframework inside TailscaleKit.xcframework.zip, so
# they land in vendor/ whenever the release asset is unzipped there.
vendor/README.txt
vendor/LICENSE-tailscale-BSD-3-Clause.txt
vendor/libtailscale/libtailscale*.a
vendor/libtailscale/libtailscale*.h
vendor/libtailscale/swift/build/

# SwiftPM build products (a root Package.swift vends the prebuilt xcframework).
.build/

# GSD planning workspace — local only. This repo is public; STATE.md and
# PROJECT.md carry working notes, relationship context, and candid assessments
# that are not for publication.
.planning/

# App Review demo credentials. `deliver` uploads these from disk, but this repo
# is public — a committed demo_user/demo_password is a working login to the
# tailnet, published. Keep them local; they are supplied per-machine.
fastlane/metadata/review_information/demo_user.txt
fastlane/metadata/review_information/demo_password.txt
